<resources>

    <style name="Theme.red" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/red</item>
        <item name="colorSecondary">@color/red</item>
        <item name="colorSurface">@color/gray</item>
        <item name="containerBackgroundColor">@color/gray</item>
        <item name="progressBarBackgroundColor">@color/gray_progress</item>
